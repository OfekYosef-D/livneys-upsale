DATABASE_URL="postgresql://postgres:postgres@localhost:5432/livneys_upsale?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used in the next reminder slice. The first DB-backed order slice can run without it.
RESEND_API_KEY=""
EMAIL_FROM="Livney's <orders@example.com>"

# WhatsApp Cloud API automation. Default is dry-run: jobs/events are created,
# but Meta is not called until WHATSAPP_SEND_ENABLED=true and templates exist.
WHATSAPP_SEND_ENABLED="false"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION="v25.0"
WHATSAPP_TEMPLATE_LANGUAGE="he"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
CRON_SECRET=""
WHATSAPP_TEMPLATE_ORDER_REMINDER=""
WHATSAPP_TEMPLATE_ORDER_RECEIVED=""
WHATSAPP_TEMPLATE_ORDER_APPROVED=""
WHATSAPP_TEMPLATE_ORDER_PACKED=""
WHATSAPP_TEMPLATE_ORDER_DELIVERED=""
WHATSAPP_TEMPLATE_ORDER_CANCELLED=""
WHATSAPP_TEMPLATE_ORDER_SPECIAL_REQUEST=""

# Product image uploads for the CRM. Uploaded URLs are stored as product imageUrl values.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_PRODUCT_FOLDER="livneys/products"
