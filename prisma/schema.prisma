generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum AuthTokenType {
  PASSWORD_SETUP
  PASSWORD_RESET
}

enum CompanyRegistrationStatus {
  PENDING
  CONTACTED
  CONVERTED
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  SPECIAL_REQUEST
  APPROVED
  PACKED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  CUSTOMER
  ADMIN
}

enum PaymentTerm {
  NET_30
  IMMEDIATE_OR_CASH
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CREDIT_CARD
  OTHER
}

enum PaymentReceiptStatus {
  RECORDED
  VOIDED
}

enum LegalDocumentType {
  COMMERCIAL_TERMS
  PRIVACY_POLICY
  CANCELLATION_RETURNS
}

enum OrderAdditionRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  EMAIL_SENT
  WHATSAPP_QUEUED
  WHATSAPP_SENT
  SKIPPED_ORDER_EXISTS
  FAILED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  DRY_RUN
  SENT
  FAILED
  CANCELLED
}

enum PromotionEffectType {
  DISPLAY_ONLY
  PERCENT_OFF
  FIXED_AMOUNT_OFF
  FIXED_UNIT_PRICE
  BUY_X_GET_Y
}

model User {
  id                        String                 @id @default(cuid())
  email                     String                 @unique
  name                      String
  passwordHash              String?
  role                      UserRole
  isActive                  Boolean                @default(true)
  sessionVersion            Int                    @default(1)
  passwordChangedAt         DateTime?
  mfaEnabled                Boolean                @default(false)
  mfaSecretEncrypted        String?
  mfaPendingSecretEncrypted String?
  customerId                String?
  customer                  Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authTokens                AuthToken[]
  mfaRecoveryCodes          MfaRecoveryCode[]
  contactLogs               CustomerContactLog[]
  reviewedAdditionRequests  OrderAdditionRequest[] @relation("OrderAdditionReviewer")
  orderActivities           OrderActivity[]
  auditLogs                 AuditLog[]
  recordedPaymentReceipts   PaymentReceipt[]       @relation("RecordedPaymentReceipts")
  voidedPaymentReceipts     PaymentReceipt[]       @relation("VoidedPaymentReceipts")
  legalAcceptances          LegalAcceptance[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([role])
  @@index([customerId])
  @@index([isActive])
}

model Customer {
  id                     String                          @id
  name                   String
  invoiceName            String?
  contact                String
  email                  String?
  phone                  String
  accountingContactName  String?
  accountingEmail        String?
  accountingPhone        String?
  businessType           String?
  region                 String
  address                String
  deliveryConstraints    String?
  notes                  String?
  statusLabel            String?
  isActive               Boolean                         @default(true)
  routeId                String
  priceListId            String
  route                  Route                           @relation(fields: [routeId], references: [id])
  priceList              PriceList                       @relation(fields: [priceListId], references: [id])
  users                  User[]
  orders                 Order[]
  additionRequests       OrderAdditionRequest[]
  recommendations        CustomerProductRecommendation[]
  promotionTargets       PromotionCustomerTarget[]
  reminderJobs           ReminderJob[]
  notificationPreference NotificationPreference?
  notificationEvents     NotificationEvent[]
  notificationJobs       NotificationJob[]
  contactLogs            CustomerContactLog[]
  whatsappWebhookEvents  WhatsAppWebhookEvent[]
  auditLogs              AuditLog[]
  legalAcceptances       LegalAcceptance[]
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  @@index([routeId])
  @@index([priceListId])
  @@index([isActive])
}

model AuthToken {
  id             String        @id @default(cuid())
  userId         String
  type           AuthTokenType
  tokenHash      String        @unique
  sessionVersion Int
  expiresAt      DateTime
  usedAt         DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([userId, type, expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model RateLimitBucket {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model Product {
  id               String                          @id
  sku              String                          @unique
  name             String
  category         String
  basePrice        Decimal                         @db.Decimal(10, 2)
  unit             String
  caseSize         String
  minQty           Int                             @default(1)
  orderMultiple    Int                             @default(1)
  imageUrl         String?
  assetImage       String?
  stockLabel       String?
  description      String?
  isActive         Boolean                         @default(true)
  priceListItems   PriceListItem[]
  orderLines       OrderLine[]
  additionLines    OrderAdditionLine[]
  promotions       Promotion[]
  promotionTargets PromotionProductTarget[]
  recommendations  CustomerProductRecommendation[]
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([category])
  @@index([isActive])
}

model CompanyRegistrationRequest {
  id                    String                    @id @default(cuid())
  businessName          String
  invoiceName           String?
  contactName           String
  phone                 String
  email                 String
  accountingContactName String?
  accountingEmail       String?
  accountingPhone       String?
  businessType          String
  address               String
  deliveryNotes         String?
  openingOrderNotes     String?
  status                CompanyRegistrationStatus @default(PENDING)
  internalNote          String?
  convertedCustomerId   String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([businessName])
  @@index([email])
}

model PriceList {
  id               String                     @id
  name             String
  description      String?
  isDefault        Boolean                    @default(false)
  items            PriceListItem[]
  customers        Customer[]
  promotionTargets PromotionPriceListTarget[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([isDefault])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  price       Decimal   @db.Decimal(10, 2)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([productId])
}

model Route {
  id               String                 @id
  name             String
  region           String
  driver           String?
  opsContactName   String?
  opsContactPhone  String?
  deliveryWeekday  Int
  cutoffWeekday    Int
  cutoffTime       String
  nextDeliveryAt   DateTime
  nextCutoffAt     DateTime
  isActive         Boolean                @default(true)
  customers        Customer[]
  orders           Order[]
  reminderRules    ReminderRule[]
  reminderJobs     ReminderJob[]
  promotionTargets PromotionRouteTarget[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([isActive])
  @@index([deliveryWeekday])
}

model Order {
  id                        String                 @id @default(cuid())
  orderNumber               Int                    @unique @default(autoincrement())
  idempotencyKey            String?                @unique
  revision                  Int                    @default(1)
  customerId                String
  routeId                   String?
  status                    OrderStatus
  source                    OrderSource            @default(CUSTOMER)
  deliveryWindowStart       DateTime
  deliveryWindowEnd         DateTime?
  deadlineAt                DateTime
  submittedAt               DateTime?
  notes                     String?
  internalNote              String?
  subtotal                  Decimal                @default(0) @db.Decimal(10, 2)
  discountTotal             Decimal                @default(0) @db.Decimal(10, 2)
  paymentTerm               PaymentTerm            @default(NET_30)
  paymentDiscountPercent    Decimal                @default(0) @db.Decimal(5, 2)
  paymentDiscountTotal      Decimal                @default(0) @db.Decimal(10, 2)
  total                     Decimal                @db.Decimal(10, 2)
  vatRatePercent            Decimal                @default(18) @db.Decimal(5, 2)
  vatTotal                  Decimal                @default(0) @db.Decimal(10, 2)
  totalIncludingVat         Decimal                @default(0) @db.Decimal(10, 2)
  commercialTermsVersion    String?
  commercialTermsAcceptedAt DateTime?
  customer                  Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  route                     Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  lines                     OrderLine[]
  additionRequests          OrderAdditionRequest[]
  activities                OrderActivity[]
  notificationJobs          NotificationJob[]
  paymentReceipts           PaymentReceipt[]
  legalAcceptances          LegalAcceptance[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([customerId, status])
  @@index([customerId, deliveryWindowStart])
  @@index([routeId, status])
  @@index([deliveryWindowStart])
  @@index([submittedAt])
}

model OrderLine {
  id                    String             @id @default(cuid())
  orderId               String
  productId             String?
  productName           String
  listUnitPrice         Decimal            @default(0) @db.Decimal(10, 2)
  unitPrice             Decimal            @db.Decimal(10, 2)
  quantity              Int
  lineSubtotal          Decimal            @default(0) @db.Decimal(10, 2)
  discountTotal         Decimal            @default(0) @db.Decimal(10, 2)
  lineTotal             Decimal            @db.Decimal(10, 2)
  promotionId           String?
  promotionSnapshot     Json?
  additionRequestLineId String?            @unique
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  promotion             Promotion?         @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  additionRequestLine   OrderAdditionLine? @relation("AppliedAdditionLine", fields: [additionRequestLineId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([promotionId])
}

model OrderAdditionRequest {
  id                        String                     @id @default(cuid())
  orderId                   String
  customerId                String
  status                    OrderAdditionRequestStatus @default(PENDING)
  revision                  Int                        @default(1)
  idempotencyKey            String                     @unique
  lastMutationKey           String                     @unique
  orderRevisionAtSubmission Int
  submittedAt               DateTime                   @default(now())
  reviewedAt                DateTime?
  reviewedByUserId          String?
  rejectionReason           String?
  subtotal                  Decimal                    @default(0) @db.Decimal(10, 2)
  discountTotal             Decimal                    @default(0) @db.Decimal(10, 2)
  paymentTerm               PaymentTerm
  paymentDiscountPercent    Decimal                    @default(0) @db.Decimal(5, 2)
  paymentDiscountTotal      Decimal                    @default(0) @db.Decimal(10, 2)
  total                     Decimal                    @default(0) @db.Decimal(10, 2)
  vatRatePercent            Decimal                    @default(18) @db.Decimal(5, 2)
  vatTotal                  Decimal                    @default(0) @db.Decimal(10, 2)
  totalIncludingVat         Decimal                    @default(0) @db.Decimal(10, 2)
  order                     Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer                  Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reviewedBy                User?                      @relation("OrderAdditionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  lines                     OrderAdditionLine[]
  activities                OrderActivity[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([orderId, status])
  @@index([customerId, status])
  @@index([reviewedByUserId])
  @@index([submittedAt])
}

model OrderAdditionLine {
  id                String               @id @default(cuid())
  requestId         String
  productId         String?
  productName       String
  quantity          Int
  listUnitPrice     Decimal              @default(0) @db.Decimal(10, 2)
  unitPrice         Decimal              @db.Decimal(10, 2)
  lineSubtotal      Decimal              @default(0) @db.Decimal(10, 2)
  discountTotal     Decimal              @default(0) @db.Decimal(10, 2)
  lineTotal         Decimal              @db.Decimal(10, 2)
  promotionId       String?
  promotionSnapshot Json?
  request           OrderAdditionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product           Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  appliedOrderLine  OrderLine?           @relation("AppliedAdditionLine")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([requestId])
  @@index([productId])
}

model OrderActivity {
  id                String                @id @default(cuid())
  orderId           String
  additionRequestId String?
  actorUserId       String?
  action            String
  metadata          Json?
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  additionRequest   OrderAdditionRequest? @relation(fields: [additionRequestId], references: [id], onDelete: SetNull)
  actorUser         User?                 @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())

  @@index([orderId, createdAt])
  @@index([additionRequestId])
  @@index([actorUserId])
}

model PaymentReceipt {
  id               String               @id @default(cuid())
  idempotencyKey   String?              @unique
  orderId          String
  amount           Decimal              @db.Decimal(10, 2)
  method           PaymentMethod
  reference        String?
  receivedAt       DateTime
  note             String?
  status           PaymentReceiptStatus @default(RECORDED)
  recordedByUserId String
  voidedAt         DateTime?
  voidedByUserId   String?
  voidReason       String?
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy       User                 @relation("RecordedPaymentReceipts", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  voidedBy         User?                @relation("VoidedPaymentReceipts", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())

  @@index([orderId, status, receivedAt])
  @@index([recordedByUserId])
  @@index([voidedByUserId])
}

model LegalAcceptance {
  id              String            @id @default(cuid())
  orderId         String
  customerId      String
  userId          String
  documentType    LegalDocumentType
  documentVersion String
  contentHash     String
  acceptedAt      DateTime
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  @@unique([orderId, documentType])
  @@index([customerId, acceptedAt])
  @@index([userId, acceptedAt])
}

model TaxRate {
  id            String    @id
  jurisdiction  String
  label         String
  ratePercent   Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([jurisdiction, effectiveFrom])
  @@index([jurisdiction, effectiveFrom, effectiveTo])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String?
  actorRole   String?
  customerId  String?
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  metadata    Json?
  requestId   String
  actorUser   User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([customerId, createdAt])
  @@index([requestId])
}

model Promotion {
  id               String                     @id
  title            String
  tag              String
  description      String
  productId        String?
  effectType       PromotionEffectType        @default(DISPLAY_ONLY)
  discountValue    Decimal?                   @db.Decimal(10, 2)
  buyQuantity      Int?
  freeQuantity     Int?
  priority         Int                        @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean                    @default(true)
  product          Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTargets   PromotionProductTarget[]
  categoryTargets  PromotionCategoryTarget[]
  customerTargets  PromotionCustomerTarget[]
  routeTargets     PromotionRouteTarget[]
  priceListTargets PromotionPriceListTarget[]
  orderLines       OrderLine[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([productId])
  @@index([isActive])
  @@index([effectType])
  @@index([priority])
}

model PromotionProductTarget {
  id          String    @id @default(cuid())
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, productId])
  @@index([productId])
}

model PromotionCategoryTarget {
  id          String    @id @default(cuid())
  promotionId String
  category    String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, category])
  @@index([category])
}

model PromotionCustomerTarget {
  id          String    @id @default(cuid())
  promotionId String
  customerId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, customerId])
  @@index([customerId])
}

model PromotionRouteTarget {
  id          String    @id @default(cuid())
  promotionId String
  routeId     String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  route       Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, routeId])
  @@index([routeId])
}

model PromotionPriceListTarget {
  id          String    @id @default(cuid())
  promotionId String
  priceListId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, priceListId])
  @@index([priceListId])
}

model CustomerProductRecommendation {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  reason     String?
  isActive   Boolean  @default(true)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([productId])
  @@index([isActive])
}

model ReminderRule {
  id                  String              @id @default(cuid())
  routeId             String?
  name                String
  hoursBeforeDelivery Int                 @default(48)
  channel             NotificationChannel
  isActive            Boolean             @default(true)
  route               Route?              @relation(fields: [routeId], references: [id], onDelete: Cascade)
  reminderJobs        ReminderJob[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([routeId])
  @@index([isActive])
}

model ReminderJob {
  id                  String              @id @default(cuid())
  reminderRuleId      String
  customerId          String
  routeId             String
  deliveryWindowStart DateTime
  channel             NotificationChannel
  status              ReminderStatus      @default(PENDING)
  scheduledAt         DateTime
  sentAt              DateTime?
  errorMessage        String?
  whatsappUrl         String?
  reminderRule        ReminderRule        @relation(fields: [reminderRuleId], references: [id], onDelete: Cascade)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  route               Route               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  notificationEvents  NotificationEvent[]
  notificationJobs    NotificationJob[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([customerId, routeId, deliveryWindowStart, channel, reminderRuleId])
  @@index([status, scheduledAt])
  @@index([routeId, deliveryWindowStart])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  customerId      String   @unique
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NotificationEvent {
  id                String              @id @default(cuid())
  customerId        String
  reminderJobId     String?
  notificationJobId String?
  channel           NotificationChannel
  type              String
  status            NotificationStatus
  subject           String?
  message           String
  templateKey       String?
  dryRun            Boolean             @default(false)
  providerMessageId String?
  providerStatus    String?
  errorMessage      String?
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reminderJob       ReminderJob?        @relation(fields: [reminderJobId], references: [id], onDelete: SetNull)
  notificationJob   NotificationJob?    @relation(fields: [notificationJobId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([customerId])
  @@index([reminderJobId])
  @@index([notificationJobId])
  @@index([status])
  @@index([providerMessageId])
}

model NotificationJob {
  id                 String                 @id @default(cuid())
  customerId         String
  orderId            String?
  reminderJobId      String?
  channel            NotificationChannel    @default(WHATSAPP)
  templateKey        String
  templateName       String?
  status             NotificationJobStatus  @default(PENDING)
  dryRun             Boolean                @default(true)
  payload            Json
  message            String?
  scheduledAt        DateTime               @default(now())
  nextAttemptAt      DateTime?
  lastAttemptAt      DateTime?
  processedAt        DateTime?
  attempts           Int                    @default(0)
  maxAttempts        Int                    @default(3)
  providerMessageId  String?
  errorMessage       String?
  dedupeKey          String                 @unique
  customer           Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order              Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reminderJob        ReminderJob?           @relation(fields: [reminderJobId], references: [id], onDelete: SetNull)
  notificationEvents NotificationEvent[]
  webhookEvents      WhatsAppWebhookEvent[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([reminderJobId])
  @@index([status, scheduledAt])
  @@index([nextAttemptAt])
  @@index([providerMessageId])
}

model WhatsAppWebhookEvent {
  id                String           @id @default(cuid())
  dedupeKey         String           @unique
  providerEventId   String?
  providerMessageId String?
  kind              String
  providerStatus    String?
  fromPhone         String?
  customerId        String?
  notificationJobId String?
  payload           Json
  receivedAt        DateTime         @default(now())
  processedAt       DateTime?
  errorMessage      String?
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notificationJob   NotificationJob? @relation(fields: [notificationJobId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([providerMessageId])
  @@index([customerId])
  @@index([notificationJobId])
  @@index([kind])
}

model CustomerContactLog {
  id         String              @id @default(cuid())
  customerId String
  userId     String?
  channel    NotificationChannel
  summary    String
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([customerId])
  @@index([userId])
}
