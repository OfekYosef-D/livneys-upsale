function createLivneysQuestionnaireForm() {
  const form = FormApp.create("שאלון איסוף מידע - פלטפורמת ההזמנות המוסדיות של ליבני'ס");

  form.setDescription(
    "מטרת השאלון היא לאסוף את כל המידע התפעולי שחסר כדי לסיים את פלטפורמת ההזמנות ללקוחות מוסדיים: לקוחות, מוצרים, מחירונים, קווי חלוקה, זמני הזמנה, תזכורות וניהול הזמנות.\n\n" +
    "נא לענות בצורה חופשית ומפורטת ככל האפשר. אם יש נושא שלא רלוונטי כרגע, אפשר לכתוב \"לא רלוונטי\"."
  );

  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setConfirmationMessage("תודה, המידע התקבל.");

  addParagraph(
    form,
    "1. שלבי הטיפול בהזמנה",
    "מהם השלבים שהזמנה עוברת מהרגע שלקוח שולח אותה ועד שהיא נסגרת?\n\n" +
      "דוגמאות: מחכה לאישור, אושרה, בליקוט, מוכנה למשלוח, סופקה, בוטלה, חריגה."
  );

  addParagraph(
    form,
    "2. טיפול בהזמנה אחרי שליחה",
    "מה קורה בפועל אחרי שלקוח שולח הזמנה במערכת?\n\n" +
      "נא לפרט מי בודק את ההזמנה, האם צריך אישור ידני, האם מותר לשנות כמויות או מוצרים, האם יוצרים קשר עם הלקוח לפני שינוי, ומה עושים עם הזמנה שנשלחה אחרי הזמן המותר."
  );

  addParagraph(
    form,
    "3. פרטי לקוח חדש בהרשמה",
    "אילו פרטים לקוח חדש חייב למלא בטופס ההרשמה למערכת?\n\n" +
      "דוגמאות: שם העסק, שם איש קשר, טלפון, מייל, ח.פ או עוסק מורשה, כתובת למשלוח, אזור בארץ, שעות קבלת משלוחים, הערות לשליח, סוג העסק, וכל פרט נוסף שחשוב לדעת לפני פתיחת לקוח."
  );

  addParagraph(
    form,
    "4. סוגי לקוחות מוסדיים",
    "אילו סוגי עסקים מוסדיים עובדים איתכם היום?\n\n" +
      "לדוגמה: מעדניות, בתי קפה, מסעדות, קייטרינג, חנויות טבע, מכולות, סופרים קטנים או סוגי עסקים אחרים.\n\n" +
      "בנוסף, האם סוג העסק משפיע על מחיר, מוצרים זמינים, כמות מינימום להזמנה, קו חלוקה או אופן העבודה מול הלקוח?"
  );

  addParagraph(
    form,
    "5. לקוח חדש, סחורה ראשונית והחזרות",
    "איך עובד תהליך פתיחת לקוח חדש מבחינת סחורה ראשונית?\n\n" +
      "נא לפרט האם שולחים ללקוח חדש סט פתיחה, האם נותנים לו את כל הממרחים/ריבות לניסיון, מה קורה עם מוצרים שלא נמכרו, האם הלקוח מחזיר אותם בהזמנה הבאה, והאם צריך לתעד את זה במערכת כהערה או כתהליך מסודר."
  );

  addParagraph(
    form,
    "6. מוצרים באתר ללקוחות מוסדיים",
    "אילו מוצרים צריכים להופיע באתר עבור לקוחות מוסדיים?\n\n" +
      "ידוע כרגע שמדובר בממרחים וריבות. נא לציין האם קיימים מוצרים נוספים שלא מופיעים באתר ללקוחות פרטיים אבל כן צריכים להופיע במערכת המוסדית."
  );

  addParagraph(
    form,
    "7. מקור מידע ותמונות למוצרים",
    "מאיפה נוכל לקחת את המידע והתמונות לכל מוצר?\n\n" +
      "נא לפרט האם להשתמש באתר הקיים, קטלוג פנימי, קבצים בדרייב, תמונות שנשלחו בוואטסאפ, צילומים קיימים, או חומרים שאתם תעבירו לנו. אם יש מוצרים שחסרים להם תמונות או תיאורים, נא לציין זאת."
  );

  addParagraph(
    form,
    "8. מחירי פתיחה למוצרים",
    "מהם מחירי הפתיחה של כל מוצר במערכת?\n\n" +
      "נא להעביר רשימת מוצרים עם מחיר לכל מוצר. אם יש כמה מחירונים, נא לציין לכל מוצר את המחיר בכל מחירון. אם יש כמות מינימום להזמנה, יחידת מכירה, מארז, או מוצר שלא אמור להיות פעיל באתר, נא לציין גם זאת."
  );

  addParagraph(
    form,
    "9. אופן קביעת מחירים ללקוחות",
    "איך נקבעים מחירים ללקוחות שונים?\n\n" +
      "נא לפרט האם יש מחיר אחיד לכל הלקוחות, מחירון לפי סוג לקוח, מחיר מיוחד לעסק מסוים, הנחות לפי כמות, מבצעים זמניים, או שינוי ידני של הבעלים. בנוסף, מי מוסמך לשנות מחיר במערכת?"
  );

  addParagraph(
    form,
    "10. קווי חלוקה ומשלוחים",
    "אילו קווי חלוקה קיימים היום ואיך הם עובדים?\n\n" +
      "נא לפרט אזורי חלוקה, ימי חלוקה, מי מבצע את המשלוח, האם כל לקוח משויך לקו קבוע, האם יש לקוחות חריגים, והאם יש אזורים שלא מגיעים אליהם."
  );

  addParagraph(
    form,
    "11. אילוצים והערות מיוחדות לפי לקוח",
    "האם יש לקוחות עם אילוצים מיוחדים שחשוב לדעת לפני משלוח או טיפול בהזמנה?\n\n" +
      "דוגמאות: לקוח שלא יכול לקבל משלוח אחרי שעה מסוימת, לקוח שיש לו שעות עומס שבהן אסור להגיע, צורך להתקשר לפני הגעה, כניסה מסוימת לפריקה, מגבלת חניה, איש קשר ספציפי לקבלת סחורה, או כל הערה אחרת שיכולה להשפיע על התפעול.\n\n" +
      "נא לציין האם אילוצים כאלה צריכים להופיע רק כהערה בכרטיס הלקוח, או להשפיע בפועל על תכנון קו החלוקה והזמנות."
  );

  addParagraph(
    form,
    "12. זמני הזמנה, ליקוט ותזכורות לפי קו חלוקה",
    "עבור כל קו חלוקה, מהם הזמנים החשובים לתפעול?\n\n" +
      "נא לפרט:\n" +
      "- מתי יוצא קו החלוקה?\n" +
      "- מתי הלקוח צריך לקבל תזכורת להזמין? לדוגמה 48 שעות לפני החלוקה.\n" +
      "- מה הזמן הכי מאוחר שבו לקוח יכול לשלוח הזמנה?\n" +
      "- כמה זמן צריך לליקוט והכנת הזמנות לפני יציאה לחלוקה?\n" +
      "- מה נחשב הזמנה מאוחרת או חריגה?"
  );

  addParagraph(
    form,
    "13. חוסרים, החלפות ומוצרים לא זמינים",
    "איך מתמודדים כיום עם חוסרים, החלפות או מוצרים שלא זמינים?\n\n" +
      "גם אם בשלב הראשון לא מתוכננת מערכת מלאי מלאה, חשוב להבין האם מתקשרים ללקוח, מחליפים מוצר, מורידים מוצר מההזמנה, או מסמנים ידנית שההזמנה דורשת טיפול."
  );

  addParagraph(
    form,
    "14. מסך ניהול ההזמנות באדמין",
    "אילו פרטים חשוב לכם לראות במסך ניהול ההזמנות?\n\n" +
      "דוגמאות: שם העסק, איש קשר, טלפון, קו חלוקה, תאריך משלוח, סטטוס הזמנה, סכום הזמנה, הערות לקוח, הערות פנימיות, מוצרים חסרים, הזמנה חריגה, או סימון שצריך ליצור קשר עם הלקוח."
  );

  addParagraph(
    form,
    "15. תזכורות והתראות פנימיות באדמין",
    "אילו תזכורות או התראות פנימיות חשוב לכם לראות במערכת?\n\n" +
      "לדוגמה: לקוחות שלא הזמינו לפני קו חלוקה, הזמנות שלא אושרו, הזמנות מאוחרות, לקוח חדש שצריך בדיקה, או הזמנות שדורשות יצירת קשר עם הלקוח."
  );

  addParagraph(
    form,
    "16. משתמשים והרשאות מצד ליבני'ס",
    "מי מטעם ליבני'ס ישתמש במערכת ומה כל אחד צריך לעשות?\n\n" +
      "נא לפרט מי צריך לנהל מוצרים, מי משנה מחירים, מי מאשר הזמנות, מי רואה לקוחות, מי מנהל קווי חלוקה, והאם יש פעולות שרק הבעלים אמורים לבצע."
  );

  addParagraph(
    form,
    "קבצים ומידע שכדאי להעביר",
    "כדי להכניס את המערכת לעבודה עם נתונים אמיתיים, נשמח לקבל:\n\n" +
      "- רשימת לקוחות מוסדיים קיימים.\n" +
      "- רשימת מוצרים מלאה ללקוחות מוסדיים.\n" +
      "- מחירי פתיחה ומחירונים, אם קיימים כמה.\n" +
      "- רשימת קווי חלוקה, ימים, שעות ודדליין להזמנה.\n" +
      "- תמונות ומידע מוצר, או מקור שממנו ניתן לקחת אותם.\n" +
      "- דוגמאות להזמנות אמיתיות מהעבר.\n" +
      "- דוגמאות לתהליך לקוח חדש שקיבל סחורה ראשונית והחזיר חלק ממנה."
  );

  addParagraph(
    form,
    "מידע נוסף",
    "האם יש מידע נוסף שחשוב לכם שנדע ולא נשאל בשאלון?\n\n" +
      "אפשר לכתוב כאן כל דבר שקשור לתהליך העבודה, לקוחות, מוצרים, הזמנות, משלוחים, חריגים, או דברים שחשוב שהמערכת תדע לתמוך בהם בהמשך."
  );

  Logger.log("Edit URL: " + form.getEditUrl());
  Logger.log("Public URL: " + form.getPublishedUrl());
}

function addParagraph(form, title, helpText) {
  form.addParagraphTextItem()
    .setTitle(title)
    .setHelpText(helpText)
    .setRequired(false);
}
